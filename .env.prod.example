# ---- Dominio público (etiqueta DNS de la IP de Azure) ----
PUBLIC_HOSTNAME=evoting-system.belgiumcentral.cloudapp.azure.com

# Origen del frontend (Railway o Render), sin "/" al final. Varios, separados por comas.
CORS_ALLOWED_ORIGINS=https://tu-frontend.up.railway.app

# ---- Bases del sistema (Neon): una por servicio ----
# Formato JDBC, conexión directa (sin "-pooler" en el host) y con SSL. Usuario y contraseña
# van en sus propias variables, nunca dentro de la URL; "channel_binding" se quita.
#   Neon: postgresql://USUARIO:CONTRASEÑA@HOST/BASE?sslmode=require&channel_binding=require
#   Aquí: jdbc:postgresql://HOST/BASE?sslmode=require

# authorization-service (claves RSA y firmas ciegas)
AUTHZ_DB_URL=jdbc:postgresql://ep-xxxxx.eu-central-1.aws.neon.tech/authorization_db?sslmode=require
AUTHZ_DB_USER=
AUTHZ_DB_PASSWORD=

# election-service (elecciones, cargos, candidatos y fotografías)
ELECTION_DB_URL=jdbc:postgresql://ep-xxxxx.eu-central-1.aws.neon.tech/election_db?sslmode=require
ELECTION_DB_USER=
ELECTION_DB_PASSWORD=

# tally-service (claves de cifrado y resultados)
TALLY_DB_URL=jdbc:postgresql://ep-xxxxx.eu-central-1.aws.neon.tech/tally_db?sslmode=require
TALLY_DB_USER=
TALLY_DB_PASSWORD=

# bulletin-board (votos cifrados, sin identidad)
BULLETIN_DB_URL=jdbc:postgresql://ep-xxxxx.eu-central-1.aws.neon.tech/bulletin_db?sslmode=require
BULLETIN_DB_USER=
BULLETIN_DB_PASSWORD=

# ---- Base de Keycloak (Neon, proyecto 2) ----
KEYCLOAK_DB_URL=jdbc:postgresql://ep-yyyyy.eu-central-1.aws.neon.tech/keycloak?sslmode=require
KEYCLOAK_DB_USER=
KEYCLOAK_DB_PASSWORD=

# ---- Keycloak ----
# Administrador inicial de la consola (https://PUBLIC_HOSTNAME/auth/admin). Usa una contraseña fuerte.
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_REALM=voting-system-realm

# Clientes confidenciales del realm (pestaña Credentials de cada cliente en la consola).
KEYCLOAK_API_GATEWAY_CLIENT_ID=
KEYCLOAK_API_GATEWAY_CLIENT_SECRET=
KEYCLOAK_AUTH_SERVICE_CLIENT_ID=
KEYCLOAK_AUTH_SERVICE_CLIENT_SECRET=

# ---- Claves privadas de las elecciones ----
# Carpeta de la VM fuera del repositorio; contiene authorization/ y tally/.
KEYS_DIR=/srv/voting-system/keys

# Plantilla de variables para docker-compose.prod.yml.
# En la VM: cp .env.prod.example .env.prod y llena los valores. .env.prod nunca va a Git.

# ---- Dominio público (etiqueta DNS de la IP de Azure) ----
PUBLIC_HOSTNAME=votacion-backend.canadacentral.cloudapp.azure.com

# Origen del frontend (Railway o Render), sin "/" al final. Varios, separados por comas.
CORS_ALLOWED_ORIGINS=https://tu-frontend.up.railway.app

# ---- Base del sistema (Neon, proyecto 1) ----
# Conexión directa (sin "-pooler" en el host) y con SSL.
VOTING_DB_URL=jdbc:postgresql://ep-xxxxx.us-east-2.aws.neon.tech/voting_system?sslmode=require
POSTGRES_USER=
POSTGRES_PASSWORD=

# ---- Base de Keycloak (Neon, proyecto 2) ----
KEYCLOAK_DB_URL=jdbc:postgresql://ep-yyyyy.us-east-2.aws.neon.tech/keycloak?sslmode=require
KEYCLOAK_DB_USER=
KEYCLOAK_DB_PASSWORD=

# ---- Keycloak ----
# Administrador inicial de la consola (https://PUBLIC_HOSTNAME/auth/admin). Usa una contraseña fuerte.
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_REALM=voting-system-realm

# Clientes confidenciales del realm (pestaña Credentials de cada cliente en la consola).
KEYCLOAK_API_GATEWAY_CLIENT_ID=
KEYCLOAK_API_GATEWAY_CLIENT_SECRET=
KEYCLOAK_AUTH_SERVICE_CLIENT_ID=
KEYCLOAK_AUTH_SERVICE_CLIENT_SECRET=

# ---- Claves privadas de las elecciones ----
# Carpeta de la VM fuera del repositorio; contiene authorization/ y tally/.
KEYS_DIR=/srv/voting-system/keys
